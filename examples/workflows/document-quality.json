{
  "schema_version": 1,
  "name": "document-quality",
  "input": {
    "kind": "image",
    "source": "USER_PROVIDED"
  },
  "limits": {
    "max_observation_seconds": 300,
    "max_frames": 300,
    "max_llm_calls": 4
  },
  "nodes": [
    {
      "id": "analyze_initial",
      "type": "analyze",
      "params": {
        "tool": "quality",
        "tool_params": {
          "initial_frames": 1
        }
      },
      "next": [
        "request_replacement"
      ]
    },
    {
      "id": "request_replacement",
      "type": "request_input",
      "params": {
        "reason": "Bitte stelle eine schärfere Aufnahme bereit."
      },
      "next": [
        "analyze_replacement"
      ]
    },
    {
      "id": "analyze_replacement",
      "type": "analyze",
      "params": {
        "tool": "quality",
        "tool_params": {
          "initial_frames": 1
        }
      },
      "next": [
        "report"
      ]
    },
    {
      "id": "report",
      "type": "report",
      "params": {
        "format": "markdown"
      },
      "next": []
    }
  ],
  "outputs": [
    {
      "type": "display",
      "requires_approval": false
    }
  ]
}
