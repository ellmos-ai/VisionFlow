{
  "schema_version": 1,
  "name": "road-monitor",
  "input": {
    "kind": "camera",
    "source": "USER_PROVIDED"
  },
  "limits": {
    "max_observation_seconds": 15,
    "max_frames": 80,
    "max_llm_calls": 1
  },
  "nodes": [
    {
      "id": "initial-direction",
      "type": "analyze",
      "params": {
        "tool": "direction",
        "tool_params": {
          "lanes": [
            {
              "id": "northbound",
              "region": [0, 90, 480, 450],
              "expected": [0, -1]
            },
            {
              "id": "southbound",
              "region": [480, 90, 480, 450],
              "expected": [0, 1]
            }
          ],
          "min_frames": 3,
          "min_displacement_px": 4.0,
          "opposition_cosine": -0.75,
          "initial_frames": 3
        }
      },
      "next": ["watch"]
    },
    {
      "id": "watch",
      "type": "observe",
      "params": {
        "duration_seconds": 5,
        "sample_fps": 5,
        "region": null,
        "stop_when": {
          "tool": "direction",
          "metric": "opposition_count",
          "operator": "gte",
          "value": 1,
          "min_consecutive": 3
        }
      },
      "next": ["candidate"]
    },
    {
      "id": "candidate",
      "type": "branch",
      "params": {
        "finding_tool": "direction",
        "metric": "opposition_count",
        "operator": "gte",
        "value": 1,
        "then_node": "candidate-tail",
        "else_node": "report"
      },
      "next": ["candidate-tail", "report"]
    },
    {
      "id": "candidate-tail",
      "type": "observe",
      "params": {
        "duration_seconds": 10,
        "sample_fps": 1,
        "region": null
      },
      "next": ["report"]
    },
    {
      "id": "report",
      "type": "report",
      "params": {
        "format": "markdown"
      },
      "next": []
    }
  ],
  "outputs": [
    {
      "type": "display",
      "requires_approval": false
    }
  ]
}